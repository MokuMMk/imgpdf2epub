<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ImgPdf2Epub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ImgPdf2Epub"
    mc:Ignorable="d"
    Title="图片 PDF 转 EPUB">

    <Grid>
        <Grid.RowDefinitions>
            <!-- ① 自绘标题栏（固定，不随内容滚动） -->
            <RowDefinition Height="Auto"/>
            <!-- ② 其余内容：整体可上下滚动 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：透明背景，透出 Mica 材质 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center" Margin="14,0,0,0">
                <FontIcon Glyph="&#xE8E5;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="图片 PDF 转 EPUB"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 可滚动内容区 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12,16,16">
            <StackPanel Spacing="12">

                <!-- 工具栏 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnAddFiles" Click="OnAddFiles">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="添加 PDF"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddFolder" Click="OnAddFolder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock Text="添加文件夹"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRemove" Click="OnRemoveSelected" Content="移除选中"/>
                    <Button x:Name="BtnClear" Click="OnClearAll" Content="清空列表"/>
                    <TextBlock x:Name="TxtFileCount" VerticalAlignment="Center"
                               Opacity="0.7" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 文件列表（固定高度，内部自行滚动） -->
                <Border Height="240" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <ListView x:Name="FileList" SelectionMode="Extended"
                                  AllowDrop="True" DragOver="OnDragOver"
                                  Drop="OnDropFiles" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileItem">
                                    <Grid ColumnSpacing="10" Padding="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind SizeText, Mode=OneWay}"
                                                   Opacity="0.7"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Status, Mode=OneWay}"
                                                   Opacity="0.85"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空列表提示 -->
                        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Spacing="6"
                                    IsHitTestVisible="False">
                            <FontIcon Glyph="&#xE8E5;" FontSize="26" Opacity="0.35"/>
                            <TextBlock Text="把 PDF 文件或文件夹拖到这里"
                                       Opacity="0.5" HorizontalAlignment="Center"/>
                            <TextBlock Text="也可以点左上角「添加 PDF」"
                                       Opacity="0.35" FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 设备与选项 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：目标设备 -->
                    <Border Grid.Column="0" CornerRadius="6" Padding="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="目标设备" FontWeight="SemiBold"/>

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="设备"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboDevice" Grid.Row="0" Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnDeviceChanged"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="屏幕"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtScreen" Grid.Row="0" Grid.Column="3"
                                         Width="96" Text="552x768"
                                         PlaceholderText="宽x高"
                                         TextChanged="OnScreenChanged"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="宽度倍数"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboHeadroom" Grid.Row="1" Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnHeadroomChanged"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="算法"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboResample" Grid.Row="1" Grid.Column="3"
                                          Width="96"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="输出格式"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboFormat" Grid.Row="2" Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnFormatChanged"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="JPG 质量"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Grid.Column="3"
                                            Orientation="Horizontal" Spacing="6">
                                    <Slider x:Name="SldQuality" Width="60" Minimum="40"
                                            Maximum="100" Value="90" StepFrequency="1"
                                            ValueChanged="OnQualityChanged"/>
                                    <TextBlock x:Name="TxtQuality" Text="90" Width="24"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtDeviceHint" TextWrapping="Wrap"
                                       FontSize="12" Opacity="0.75"/>
                        </StackPanel>
                    </Border>

                    <!-- 右：通用选项 -->
                    <Border Grid.Column="1" CornerRadius="6" Padding="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="通用选项（选「通用」设备时生效）"
                                       FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="图片格式"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboGenFormat" Grid.Row="0" Grid.Column="1"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="缩放"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboScale" Grid.Row="1" Grid.Column="1"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="显示"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CboDisplay" Grid.Row="2" Grid.Column="1"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>

                            <StackPanel Spacing="4">
                                <CheckBox x:Name="ChkGray" Content="灰度化（减小体积）"/>
                                <CheckBox x:Name="ChkTrim" Content="自动裁白边"/>
                                <CheckBox x:Name="ChkCover" Content="首张图片设为封面"
                                          IsChecked="True"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 输出目录 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="输出目录"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOutDir" Grid.Column="1"
                             PlaceholderText="留空 = 与源文件同目录"/>
                    <Button Grid.Column="2" Content="浏览…" Click="OnBrowseOutDir"/>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnStart" Click="OnStart"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="开始转换"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCancel" Content="取消" Click="OnCancel"
                            IsEnabled="False"/>
                    <Button x:Name="BtnOpenOut" Content="打开输出目录" Click="OnOpenOutDir"/>
                    <Button x:Name="BtnClearLog" Content="清空日志" Click="OnClearLog"/>
                </StackPanel>

                <!-- 进度 -->
                <StackPanel Spacing="4">
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="TxtStatus" Text="就绪" FontSize="12"
                               Opacity="0.75"/>
                </StackPanel>

                <!-- 日志 -->
                <Border Height="130" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ScrollViewer x:Name="LogScroll" Padding="10"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtLog" TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="12"
                                   IsTextSelectionEnabled="True"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
