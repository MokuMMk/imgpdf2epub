<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>ImgPdf2Epub</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>图片PDF转EPUB-界面</AssemblyName>
    <!-- 应用图标（任务栏 / 资源管理器 / 快捷方式） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 单文件发布所需 -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 关掉 WinRT AOT 源生成器：它与 .NET 8 SDK 组合时会重复生成
         CCS vtable 类型表，导致 CS0101/CS0111/CS0579 冲突。 -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <EnableCsWinRTAotOptimizer>false</EnableCsWinRTAotOptimizer>
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 强制把传递依赖抬到本地已缓存的版本 -->
    <PackageReference Include="Microsoft.Windows.SDK.NET.Ref" Version="10.0.19041.57"
                      ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <!--
    Windows App SDK 2.5.x 的元包会连带 AI / ML / Widgets / Search 组件，
    其中 onnxruntime.dll(20MB) 和 DirectML.dll(18MB) 我们完全用不到。
    这里显式排除，发布的体积能小一大截。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时用 AppWindow.SetIcon 读取，必须复制到输出目录 -->
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
